<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Include="Library.fs" />
    <Compile Include="Content.fs" />
    <Compile Include="Http.fs" />
    <Compile Include="Editor.fs" />
    <Compile Include="Presentation.fs" />
    <Compile Include="ResponseView.fs" />
    <Compile Include="BodyEditor.fs" />
    <PackageReference Include="AngleSharp" Version="1.5.2" GeneratePathProperty="true" />
    <None Include="$(PkgAngleSharp)/lib/net10.0/AngleSharp.dll" Link="AngleSharp.dll" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="Definitions.fs" />
    <Compile Include="History.fs" />
    <Compile Include="Sender.fs" />
    <Compile Include="Plugin.fs" />
    <ProjectReference Include="../Contracts/Contracts.fsproj" />
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
