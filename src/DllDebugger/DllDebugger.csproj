<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Catalog/windows-sdk.tsv" LogicalName="WindowsApi.tsv" />
    <InternalsVisibleTo Include="DllDebugger.Tests" />
    <CaptureArch Include="x86;x64" />
    <Content Include="$(BaseIntermediateOutputPath)monitor/x86/capture.exe" Link="monitor/x86/capture.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(BaseIntermediateOutputPath)monitor/x64/capture.exe" Link="monitor/x64/capture.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildCapture" BeforeTargets="PrepareForBuild"
          Inputs="MonitorNative/capture.cpp;MonitorNative/build.ps1"
          Outputs="$(BaseIntermediateOutputPath)monitor/%(CaptureArch.Identity)/capture.exe">
    <Exec Command="pwsh -NoProfile -File MonitorNative/build.ps1 %(CaptureArch.Identity) &quot;$(BaseIntermediateOutputPath)monitor/%(CaptureArch.Identity)/capture.exe&quot;" />
  </Target>
</Project>
