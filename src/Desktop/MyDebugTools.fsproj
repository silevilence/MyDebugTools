<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SignatureEditor.fs" />
    <Compile Include="BindingPanel.fs" />
    <Compile Include="DllWorkbench.fs" />
    <Compile Include="Shell.fs" />
    <Compile Include="Program.fs" />
    <ProjectReference Include="../Host/Host.fsproj" />
    <ProjectReference Include="../WebApi/WebApi.fsproj" ReferenceOutputAssembly="false" />
    <Content Include="../WebApi/bin/$(Configuration)/$(TargetFramework)/WebApi.dll;../WebApi/bin/$(Configuration)/$(TargetFramework)/AngleSharp.dll;../WebApi/plugin.json"
             Link="plugins/WebApi/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../DllDependencies/DllDependencies.fsproj" ReferenceOutputAssembly="false" />
    <Content Include="../DllDependencies/bin/$(Configuration)/$(TargetFramework)/DllDependencies.dll;../DllDependencies/plugin.json"
             Link="plugins/DllDependencies/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../ApiMonitor/ApiMonitor.fsproj" ReferenceOutputAssembly="false" />
    <Content Include="../ApiMonitor/bin/$(Configuration)/$(TargetFramework)/ApiMonitor.dll;../ApiMonitor/plugin.json"
             Link="plugins/ApiMonitor/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../DllDebugger/DllDebugger.csproj" />
    <ProjectReference Include="../../samples/Workbench/Workbench.fsproj" />
    <ProjectReference Include="../../samples/WorkbenchActions/WorkbenchActions.fsproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>
</Project>
